# Stessa password in entrambe (e in src/config/admin.local.js)
ADMIN_PASSWORD=la-tua-password-sicura
VITE_ADMIN_PASSWORD=la-tua-password-sicura

# Redis Cloud (da redis-cli -u redis://...)
REDIS_URL=redis://default:PASSWORD@HOST:PORT

# Oppure Upstash REST (Vercel Marketplace)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
